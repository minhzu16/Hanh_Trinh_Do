{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hotspots.json — điểm tương tác khám phá bối cảnh",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "sceneId",
      "title",
      "x",
      "y",
      "icon",
      "description",
      "historicalNote",
      "sources"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^hs-[a-z0-9-]+$" },
      "sceneId": { "type": "string", "pattern": "^k[0-9]+-c[0-9]+$" },
      "title": { "type": "string", "minLength": 1 },
      "x": { "type": "number", "minimum": 0, "maximum": 100 },
      "y": { "type": "number", "minimum": 0, "maximum": 100 },
      "icon": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 },
      "historicalNote": { "type": "string", "minLength": 1 },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "pattern": "^GT-[0-9]+-[A-Z0-9-]+$" }
      }
    }
  }
}

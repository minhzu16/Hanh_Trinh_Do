{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "glossary.json — tra cứu thuật ngữ lịch sử (docs/03-story-spec.md mục 13)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "term",
      "definition",
      "sources"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "term": {
        "type": "string",
        "minLength": 1
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "definition": {
        "type": "string",
        "minLength": 1
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^GT-[0-9]+-[A-Z0-9-]+$"
        }
      }
    }
  }
}


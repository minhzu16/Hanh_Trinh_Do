{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sources.json — nguồn trích giáo trình (docs/03-story-spec.md mục 7)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "pages", "kind", "text"],
    "properties": {
      "id": { "type": "string", "pattern": "^GT-[0-9]+-[A-Z0-9-]+$" },
      "pages": { "type": "string", "pattern": "^[0-9]+(–[0-9]+)?$" },
      "kind": { "enum": ["quote", "fact"] },
      "text": { "type": "string", "minLength": 1 }
    }
  }
}

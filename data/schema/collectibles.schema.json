{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "collectibles.json — tư liệu mở khoá",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "chapter", "caption"],
    "properties": {
      "id": { "type": "string", "pattern": "^tl-[a-z0-9-]+$" },
      "title": { "type": "string", "minLength": 1 },
      "chapter": { "type": "string", "pattern": "^k[0-9]+$" },
      "caption": { "type": "string", "minLength": 1 },
      "source": { "type": "string", "pattern": "^GT-[0-9]+-[A-Z0-9-]+$" },
      "image_credit": { "type": "string" }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "journal.json — nhật ký của Minh cuối mỗi kỳ (docs/11-lo-trinh-hoan-thien.md mục P14)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "chapterId",
      "title",
      "entries"
    ],
    "properties": {
      "chapterId": {
        "type": "string",
        "pattern": "^k[0-9]+$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "entries": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "text",
            "sources"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^k[0-9]+-j[0-9]+$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^GT-[0-9]+-[A-Z0-9-]+$"
              }
            }
          }
        }
      }
    }
  }
}


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chapters.json — các kỳ (docs/03-story-spec.md mục 2)",
  "type": "array",
  "minItems": 3,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "period", "goal", "pages", "minutes_target", "scenes"],
    "properties": {
      "id": { "type": "string", "pattern": "^k[0-9]+$" },
      "title": { "type": "string", "minLength": 1 },
      "period": { "type": "string", "minLength": 1 },
      "goal": { "type": "string", "minLength": 1 },
      "pages": { "type": "string", "pattern": "^[0-9]+(–[0-9]+)?$" },
      "minutes_target": { "type": "number", "minimum": 1 },
      "scenes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^k[0-9]+-c[0-9]+$" } }
    }
  }
}

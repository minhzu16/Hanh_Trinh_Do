{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contexts.json — bối cảnh địa danh và thời gian của các cảnh",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sceneId",
      "location",
      "time",
      "subtitle",
      "sources"
    ],
    "properties": {
      "sceneId": { "type": "string", "pattern": "^k[0-9]+-c[0-9]+$" },
      "location": { "type": "string", "minLength": 1 },
      "time": { "type": "string", "minLength": 1 },
      "subtitle": { "type": "string", "minLength": 1 },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "pattern": "^GT-[0-9]+-[A-Z0-9-]+$" }
      }
    }
  }
}


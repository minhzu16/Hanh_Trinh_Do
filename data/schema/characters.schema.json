{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "characters.json — nhân vật (docs/03-story-spec.md mục 6)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "kind", "description", "sprites"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "name": { "type": "string", "minLength": 1 },
      "kind": { "enum": ["fictional", "historical", "system"] },
      "description": { "type": "string" },
      "sprites": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
    }
  }
}
